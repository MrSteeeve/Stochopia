# Stochopia API key 示例。复制为 .env 并填入真实值。
# 只需填写实际用到的模型对应的 key。

# DeepSeek V4（config/models.yaml 中的 deepseek-v4-flash 与 deepseek-v4-pro）
DEEPSEEK_API_KEY=

# MiniMax（minimax）
MINIMAX_API_KEY=

# 阿里云 DashScope（qwen-max）
DASHSCOPE_API_KEY=

# OpenAI（gpt-4o）
OPENAI_API_KEY=

# Anthropic（claude-sonnet）
ANTHROPIC_API_KEY=
